{% include "head.liquid" %}
<article class="post prose">
    <header class="page-head">
        <p class="eyebrow"><a href="/posts/">Blog</a></p>
        <h1>{{ page.title }}</h1>
        {% if page.description %}<p class="lede">{{ page.description }}</p>{% endif %}

        <div class="post-meta">
            {% if page.published_date %}
            <time datetime="{{ page.published_date | date: '%Y-%m-%d' }}">
                {{ page.published_date | date: "%B %e, %Y" }}
            </time>
            {% endif %}
            {% if page.data.category %}<span class="chip">{{ page.data.category }}</span>{% endif %}
            {% if page.data.reading_time %}<span>{{ page.data.reading_time }} min read</span>{% endif %}
        </div>
    </header>

    {{ page.content }}

    <footer class="post-footer">
        {% if page.data.tags %}
        <div class="tags">
            {% for tag in page.data.tags %}<span class="chip">{{ tag }}</span>{% endfor %}
        </div>
        {% endif %}

        <div class="post-nav">
            {% if page.data.prev %}<a href="{{ page.data.prev }}">&larr; Previous</a>{% endif %}
            {% if page.data.next %}<a href="{{ page.data.next }}" class="next">Next &rarr;</a>{% endif %}
        </div>
    </footer>
</article>
{% include "foot.liquid" %}
