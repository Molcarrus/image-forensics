{% include "head.liquid" %}
<article class="page prose">
    {% if page.title %}
    <header class="page-head">
        <h1>{{ page.title }}</h1>
        {% if page.description %}<p class="lede">{{ page.description }}</p>{% endif %}
    </header>
    {% endif %}
    {{ page.content }}
</article>
{% include "foot.liquid" %}
